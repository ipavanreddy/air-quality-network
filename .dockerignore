!services/api/uv.lock
!services/api/.python-version
!services/api/app/**
!ai/prompts/**
!ai/schemas/**
!data/adapters/**
!data/schemas/**
!data/sample/**
**/__pycache__
**/*.pyc
**/.env
**/.env.*
