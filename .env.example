# Copy to .env (never commit). On Cloud Run these are set by infrastructure/cloud-run/deploy.sh
# (plain env vars + Secret Manager for API keys).

# Google AI Studio key (or leave empty and use Vertex AI via ADC, as production does)
GEMINI_API_KEY=

# Gemini model ID
GEMINI_MODEL=gemini-2.5-flash

# true to route Gemini through Vertex AI (service account / ADC) instead of the API key
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project ID
GOOGLE_CLOUD_PROJECT=

# Vertex AI location for Gemini. "global" avoids the regional 429s seen in asia-south1.
GOOGLE_CLOUD_LOCATION=global

# Path to service-account JSON (local dev only; Cloud Run uses its SA)
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery dataset for this project
BIGQUERY_DATASET=air_quality_network

# Cloud Storage bucket for media/artifacts
GCS_BUCKET=

# Firebase project ID (usually = GCP project)
FIREBASE_PROJECT_ID=

# API key for Cloud Speech-to-Text, Text-to-Speech and Translation (or leave empty to use ADC).
# Do NOT name it GOOGLE_API_KEY: the google-genai SDK would treat that as a Gemini key and break Vertex AI mode.
GOOGLE_CLOUD_API_KEY=

# Server-side Maps key (Geocoding: report address + locality search)
MAPS_API_KEY=

# GCP project registered for Earth Engine
EARTH_ENGINE_PROJECT=

# data.gov.in key for CPCB real-time AQ
DATA_GOV_IN_API_KEY=

# Shared secret for sensor ingest endpoint (generate any random string)
SENSOR_INGEST_TOKEN=

# true = ignore all keys above and run fully on labelled sample data + AI fixtures (tests set this)
FORCE_DEMO_MODE=false

# API
PORT=8020
CORS_ORIGINS=http://localhost:3020,http://localhost:3021
# Optional regex for extra origins, e.g. Vercel preview URLs: https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
