# Copy to .env (never commit). Cloud Run reads these from Secret Manager.

# Google AI Studio key (or leave empty and use Vertex AI via ADC)
GEMINI_API_KEY=

# Gemini model ID - confirm exact ID in AI Studio
GEMINI_MODEL=gemini-flash-latest

# true to route Gemini through Vertex AI instead of the API key
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project ID
GOOGLE_CLOUD_PROJECT=

# asia-south1
GOOGLE_CLOUD_LOCATION=asia-south1

# Path to service-account JSON (local dev only; Cloud Run uses its SA)
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery dataset for this project
BIGQUERY_DATASET=air_quality_network

# Cloud Storage bucket for media/artifacts
GCS_BUCKET=

# Firebase project ID (usually = GCP project)
FIREBASE_PROJECT_ID=

# Server-side Maps key (Geocoding/Routes)
MAPS_API_KEY=

# GCP project registered for Earth Engine
EARTH_ENGINE_PROJECT=

# data.gov.in key for CPCB real-time AQ
DATA_GOV_IN_API_KEY=

# Shared secret for sensor ingest endpoint (generate any random string)
SENSOR_INGEST_TOKEN=

# true = ignore all keys above and run fully on labelled sample data + AI fixtures (tests set this)
FORCE_DEMO_MODE=false

# API
PORT=8020
CORS_ORIGINS=http://localhost:3020,http://localhost:3021
